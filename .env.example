# Copy to .env (dev) and .env.test (e2e, with a separate database such as dsm_test).
# Values below are for `pnpm supabase start`; production values live in Render.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Runtime: Supabase transaction pooler (port 6543) in production. Locally both URLs are the same.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Migrations: Supabase session pooler or direct connection (port 5432) in production.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# https://<ref>.supabase.co in production. JWKS and issuer are derived from it.
SUPABASE_URL=http://127.0.0.1:54321
